# server 镜像 context 是仓库根(server/Dockerfile 只 COPY server/ deploy/bootstrap/ data/updates/),
# 这里排除大体积 / 敏感 / 无关产物,缩小上传到 builder 的 context、杜绝密钥进层。
.git
.github
.venv
.venv-embedding
**/__pycache__
**/*.pyc
.env
.env.*
!.env.example
node_modules
apps/web/node_modules
apps/web/.next
apps/web/dist
*.dist
*.log
.DS_Store
.pytest_cache
.ruff_cache
# TS workspace (web image context is the repo root too): build output and the
# desktop/mobile apps aren't part of any server-side image.
packages/*/node_modules
packages/*/dist
apps/desktop
apps/mobile
