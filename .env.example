# ─────────────────────────────────────────────────────────────
# Memento — environment template
#
# Copy this file to `.env` (or let ./install.sh do it for you)
# and fill in the values you care about.
#
# Required secrets — if omitted, the installer generates random
# values on first run. Never commit these to a public repo.
# ─────────────────────────────────────────────────────────────

# Signs JWTs. Must be >= 32 chars, high entropy.
MEMENTO_SECRET_KEY=

# Token used by collectors to register themselves.
MEMENTO_COLLECTOR_TOKEN=

# Postgres superuser password. docker-compose.yml builds the api's
# database URL from it, so it is the only place to set it.
POSTGRES_PASSWORD=

# MinIO / S3 credentials.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ─────────────────────────────────────────────────────────────
# Optional — AI backends for daily summaries & graph extraction
# ─────────────────────────────────────────────────────────────

# Anthropic Claude (reaches the api as MEMENTO_ANTHROPIC_API_KEY). Leave blank to disable.
ANTHROPIC_API_KEY=

# Alternate OpenAI-compatible endpoint (Aliyun / Kimi / etc.)
# Leave blank to disable the alt backend.
MEMENTO_AI_API_KEY=
MEMENTO_AI_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
MEMENTO_AI_MODEL=kimi-k2.5

# ─────────────────────────────────────────────────────────────
# Optional — embedding server (semantic search + MCP memory recall)
# ─────────────────────────────────────────────────────────────
#
# Unset = the compose `embedding` service (`./install.sh embedding`),
# reached at http://embedding:8002. `./install.sh embedding --native`
# (GPU / Apple MPS on the host) writes http://host.docker.internal:8002
# here; docker-compose.yml maps that name to the host on Linux too.
# Another machine: its address, e.g. http://<embedding-host>:8002
# MEMENTO_EMBEDDING_SERVER_URL=
#
# No local model at all: an OpenAI-compatible embeddings API.
# MEMENTO_EMBEDDING_PROVIDER=openai
# MEMENTO_EMBEDDING_API_URL=https://api.siliconflow.cn/v1
# MEMENTO_EMBEDDING_API_KEY=
# MEMENTO_EMBEDDING_MODEL=BAAI/bge-m3

# ─────────────────────────────────────────────────────────────
# Optional — PyPI mirror for Docker build (slow / blocked networks)
# ─────────────────────────────────────────────────────────────
#
# Default empty = use pypi.org directly. If `docker compose build` times
# out reading files.pythonhosted.org, set a faster mirror here. The api +
# celery-worker + celery-beat services all honor this build arg.
#
# Mainland China options:
#   PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
#   PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
#   PIP_INDEX_URL=https://pypi.mirrors.ustc.edu.cn/simple/
# PIP_INDEX_URL=

# ─────────────────────────────────────────────────────────────
# Optional — any other server setting
# ─────────────────────────────────────────────────────────────
#
# The api and celery containers read this whole file (env_file in
# docker-compose.yml), so every MEMENTO_* setting in the README's
# server table can go here; `./install.sh` keeps them when it re-runs.
# Single quotes keep `$` literal (Compose expands `$NAME` otherwise).
# MEMENTO_CORS_ALLOW_ORIGIN_REGEX='^https://mem\.example\.com$'
# MEMENTO_PUBLIC_URL=https://mem.example.com
# MEMENTO_REGISTRATION_MODE=closed
# MEMENTO_REMOTE_EXEC=1
