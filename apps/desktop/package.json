{
  "name": "@memento/desktop",
  "productName": "Memento",
  "version": "1.0.84",
  "private": true,
  "description": "Memento: the web app in a window, with the local daemon, tray and auto-update",
  "author": "Memento",
  "homepage": "https://mem.ihasy.com",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "npm run build -w @memento/daemon && npm run build -w @memento/mcp && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "test": "vitest run"
  },
  "devDependencies": {
    "@memento/daemon": "*",
    "@memento/mcp": "*",
    "@types/node": "^22.10.0",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
