{
  "expo": {
    "name": "Memento",
    "slug": "memento",
    "version": "1.0.67",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ihasy.memento",
      "buildNumber": "6",
      "appleTeamId": "WHNZV34GK4",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Memento 需要使用麦克风以支持语音吩咐与实时听写功能。",
        "NSSpeechRecognitionUsageDescription": "Memento 需要语音识别权限以将您的语音吩咐实时转录为文字。",
        "NSPhotoLibraryUsageDescription": "Memento 需要访问相册以选取照片生成专属卡通数字孪生形象或更换头像。",
        "NSCameraUsageDescription": "Memento 需要使用相机以拍摄照片生成专属卡通数字孪生形象或头像。",
        "NSPhotoLibraryAddUsageDescription": "Memento 需要保存生成的数字孪生形象卡片或导出的知识图谱至相册。",
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7C3AED",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ihasy.memento",
      "permissions": ["android.permission.PACKAGE_USAGE_STATS"]
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#7C3AED"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#F6F5FB",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B0B12"
          }
        }
      ],
      "./plugins/withLiveActivity.js"
    ],
    "scheme": "memento",
    "experiments": {
      "typedRoutes": true
    }
  }
}
