# memento 企业部署配置。./memento.sh init 会复制成 .env 并填好密码和密钥；其余按需改。
# 改完执行 ./memento.sh up 生效。各项说明见 docs/enterprise.md。

# ---- 访问地址 ----
# 员工访问的地址（不带结尾斜杠），单点登录回调、安装命令都用它
MEMENTO_PUBLIC_URL=https://memento.example.com
# 入口监听的站点：一般就是上面的域名。公网域名会自动申请 HTTPS 证书；
# 只在内网用、没有公网解析：写域名并把 MEMENTO_TLS 设成 "tls internal"（自签证书，需把根证书下发到员工电脑），
# 或者前面已有公司负载均衡做 HTTPS：写 ":80"，MEMENTO_TLS 留空
MEMENTO_SITE=memento.example.com
MEMENTO_TLS=
MEMENTO_HTTP_PORT=80
MEMENTO_HTTPS_PORT=443
# 只允许从这些来源的网页调用接口（正则），默认只允许本站
MEMENTO_CORS_ALLOW_ORIGIN_REGEX=^https://memento\.example\.com$

# ---- 镜像版本（init 时写入当前发布的版本；升级用 ./memento.sh upgrade）----
MEMENTO_SERVER_TAG=
MEMENTO_WEB_TAG=
# 用公司内网镜像仓库时改这两项（先用 ./memento.sh bundle 打包、推到内网仓库）
# MEMENTO_SERVER_IMAGE=harbor.example.com/memento/memento-server
# MEMENTO_WEB_IMAGE=harbor.example.com/memento/memento-web

# ---- 密码与密钥（init 自动生成，不要提交到任何仓库）----
POSTGRES_PASSWORD=
MINIO_ROOT_USER=memento
MINIO_ROOT_PASSWORD=
MEMENTO_SECRET_KEY=
MEMENTO_COLLECTOR_TOKEN=
# 加密数据库里用户模型密钥的密钥；留空时由 MEMENTO_SECRET_KEY 派生。改了之后已存的密钥无法解开，用户需重新填写
MEMENTO_DATA_KEY=

# ---- 企业策略 ----
# own：管理员只看自己的数据（推荐企业使用）；all：管理员能看所有人的对话、记忆、设备
MEMENTO_ADMIN_SCOPE=own
# 注册方式：invite_only 只能凭邀请码注册；closed 不开放注册（账号由单点登录或 SCIM 开通）
MEMENTO_REGISTRATION_MODE=closed
# 全员用企业账号登录后改成 false：除所有者外不能再用密码、GitHub、微信登录
MEMENTO_PASSWORD_LOGIN=true
# 审计日志保留天数（0 为永久）
MEMENTO_AUDIT_RETENTION_DAYS=365
# 员工能自己配置的模型服务域名，逗号分隔，支持 *.example.com；留空不限制
MEMENTO_ALLOWED_MODEL_HOSTS=
# 是否允许从网页向员工电脑派发命令和智能体任务（1 开启，0 关闭）
MEMENTO_REMOTE_EXEC=1
# 一台电脑上的智能体在代码所在电脑上执行命令、写项目以外的文件时：
#   off 都不拦，有风险的（sudo、改 /etc、rm -rf、写 ~/.ssh 等）照常执行并推送提醒
#   catastrophic 另外拦下会毁掉那台电脑的命令（格式化磁盘、删整个主目录或系统目录、关机重启）
#   strict 拦下所有有风险的命令和敏感文件
MEMENTO_REMOTE_EXEC_POLICY=catastrophic

# ---- 单点登录（OpenID Connect）----
# 在身份平台建一个「机密客户端」，回调地址填 ${MEMENTO_PUBLIC_URL}/api/auth/oidc/callback
MEMENTO_OIDC_ISSUER=
MEMENTO_OIDC_CLIENT_ID=
MEMENTO_OIDC_CLIENT_SECRET=
MEMENTO_OIDC_DISPLAY_NAME=企业账号
MEMENTO_OIDC_SCOPES=openid email profile
# 只允许这些邮箱域名登录，逗号分隔
MEMENTO_OIDC_ALLOWED_DOMAINS=
# 第一次登录时自动开通账号
MEMENTO_OIDC_AUTO_CREATE=true
# 这个组（身份平台的 groups 声明）的成员登录后是管理员，其他人是普通成员；留空不按组调整
MEMENTO_OIDC_ADMIN_GROUP=

# ---- SCIM 账号同步（身份平台开通、停用账号）----
# 地址 ${MEMENTO_PUBLIC_URL}/api/scim/v2，身份平台用 Bearer 令牌访问；留空关闭
MEMENTO_SCIM_TOKEN=

# ---- 大模型（OpenAI 兼容接口，建议用公司内网部署的模型）----
MEMENTO_AI_BASE_URL=
MEMENTO_AI_API_KEY=
MEMENTO_AI_MODEL=
MEMENTO_AI_BACKGROUND_MODEL=
# 不用默认的备用模型服务：两项都留空即可（不会向外部发送数据）
MEMENTO_AI_FALLBACK_BASE_URL=
MEMENTO_AI_FALLBACK_API_KEY=

# ---- 向量模型（OpenAI 兼容的 embeddings 接口，例如内网部署的 bge-m3）----
MEMENTO_EMBEDDING_PROVIDER=openai
MEMENTO_EMBEDDING_API_URL=
MEMENTO_EMBEDDING_API_KEY=
MEMENTO_EMBEDDING_MODEL=BAAI/bge-m3
