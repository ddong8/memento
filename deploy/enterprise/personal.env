# 单机（个人）模式：在 .env.example 的基础上改这些。只给自己用，跑在自己电脑上。
# ./memento.sh init --personal 和桌面端「在这台电脑上运行」都按这里生成 .env（密码与密钥另外随机生成）。
#
# 只在本机能打开：http://localhost:8770。手机要用时把 MEMENTO_HTTP_PORT 改成 8770（所有网卡），
# 再用 http://<电脑的局域网地址>:8770 访问，然后 ./memento.sh up。
# 标记：memento.sh 据此让 docker 不用凭据存储（镜像都是公开的）
DEPLOY_MODE=personal
MEMENTO_PUBLIC_URL=http://localhost:8770
MEMENTO_SITE=:80
MEMENTO_TLS=
MEMENTO_HTTP_PORT=127.0.0.1:8770
MEMENTO_HTTPS_PORT=127.0.0.1:8771
MEMENTO_CORS_ALLOW_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1)(:\d+)?$
# 支持 Intel 与 Apple 芯片 / ARM 服务器的镜像，跟着正式发布更新
MEMENTO_SERVER_TAG=stable
MEMENTO_WEB_TAG=stable
# 第一个注册的人是所有者；之后不再开放注册
MEMENTO_REGISTRATION_MODE=closed
MEMENTO_ADMIN_SCOPE=own
