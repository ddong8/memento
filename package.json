{
  "name": "memento",
  "private": true,
  "description": "Memento monorepo: shared TypeScript packages, web, desktop and mobile clients",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build -w web && npm run build -w @memento/desktop",
    "build:core": "npm run build -w @memento/core",
    "lint": "npm run lint --workspaces --if-present",
    "gen:api": "npm run gen:api -w @memento/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "expo-router": "~57.0.23"
  }
}
