// Generate / merge .env: idempotent, never clobbers existing values.
import { randomBytes } from "node:crypto";
import { chmodSync, existsSync, readFileSync, renameSync, rmSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { Interrupted, REPO_ROOT, ask, info, ok } from "./platform.mts";

export const ENV_PATH = join(REPO_ROOT, ".env");

/** KEY=value lines of a dotenv file; comments and lines without `=` skipped. */
export function parseEnv(path: string): Record<string, string> {
  if (!existsSync(path)) return {};
  const result: Record<string, string> = {};
  for (const raw of readFileSync(path, "utf8").split(/\r\n|\r|\n/)) {
    const line = raw.trim();
    if (!line || line.startsWith("#")) continue;
    const eq = line.indexOf("=");
    if (eq < 0) continue;
    result[line.slice(0, eq).trim()] = line.slice(eq + 1).trim();
  }
  return result;
}

const SECRET_KEYS = ["MEMENTO_SECRET_KEY", "MEMENTO_COLLECTOR_TOKEN", "POSTGRES_PASSWORD", "MINIO_ROOT_USER", "MINIO_ROOT_PASSWORD"];
const AI_KEYS = [
  "ANTHROPIC_API_KEY",
  "MEMENTO_AI_API_KEY",
  "MEMENTO_AI_BASE_URL",
  "MEMENTO_AI_MODEL",
  "MEMENTO_AI_FALLBACK_API_KEY",
  "MEMENTO_AI_FALLBACK_BASE_URL",
  "MEMENTO_AI_FALLBACK_MODEL",
  "MEMENTO_AI_PROVIDERS",
];
const EMBEDDING_KEY = "MEMENTO_EMBEDDING_SERVER_URL";

/** The .env text for these values. */
export function renderEnv(values: Record<string, string>): string {
  const lines = ["# Memento — generated by ./install.sh", "# Safe to re-run: the installer preserves existing values.", "", "# ── required secrets ──"];
  for (const key of SECRET_KEYS) lines.push(`${key}=${values[key] ?? ""}`);
  lines.push("", "# ── optional AI backends ──");
  for (const key of AI_KEYS) lines.push(values[key] ? `${key}=${values[key]}` : `# ${key}=`);
  lines.push(
    "",
    "# ── optional: embedding server URL ──",
    "# Unset = the compose `embedding` service (http://embedding:8002,",
    "# `./install.sh embedding`). `./install.sh embedding --native` sets",
    "# http://host.docker.internal:8002; another machine: its address.",
  );
  lines.push(values[EMBEDDING_KEY] ? `${EMBEDDING_KEY}=${values[EMBEDDING_KEY]}` : `# ${EMBEDDING_KEY}=http://embedding:8002`);
  // Anything else the user put in .env (MEMENTO_CORS_ALLOW_ORIGIN_REGEX, PIP_INDEX_URL, ...) reaches the
  // containers via env_file, so a re-run must keep it rather than rewrite .env down to the keys above.
  const known = new Set([...SECRET_KEYS, ...AI_KEYS, EMBEDDING_KEY]);
  const others = Object.keys(values).filter((k) => !known.has(k));
  if (others.length) lines.push("", "# ── other settings (kept from your .env) ──", ...others.map((k) => `${k}=${values[k]}`));
  lines.push("");
  return lines.join("\n");
}

/** Written to a temp file beside it and renamed over, readable by the owner only. */
function writeEnvAtomic(path: string, values: Record<string, string>): void {
  const tmp = join(dirname(path), `.env.${randomBytes(6).toString("hex")}`);
  try {
    writeFileSync(tmp, renderEnv(values), { encoding: "utf8", mode: 0o600, flag: "wx" });
    renameSync(tmp, path);
  } catch (e) {
    rmSync(tmp, { force: true });
    throw e;
  }
  try {
    chmodSync(path, 0o600);
  } catch {
    // Windows
  }
}

/** Sets one key in `.env`, keeping everything else. */
export async function setEnvValue(key: string, value: string, path = ENV_PATH): Promise<void> {
  if (!existsSync(path)) await ensureEnv({ interactive: false, path });
  const values = parseEnv(path);
  values[key] = value;
  writeEnvAtomic(path, values);
}

const urlsafe = (bytes: number) => randomBytes(bytes).toString("base64url");
const hex = (bytes: number) => randomBytes(bytes).toString("hex");

/** Makes sure `.env` has every required secret, generating the missing ones; returns the merged values. */
export async function ensureEnv({ interactive = true, path = ENV_PATH } = {}): Promise<Record<string, string>> {
  const merged = parseEnv(path);
  const required: Record<string, () => string> = {
    MEMENTO_SECRET_KEY: () => urlsafe(48),
    MEMENTO_COLLECTOR_TOKEN: () => hex(32),
    POSTGRES_PASSWORD: () => urlsafe(24),
    MINIO_ROOT_USER: () => `memento_${hex(4)}`,
    MINIO_ROOT_PASSWORD: () => urlsafe(24),
  };
  const generated: string[] = [];
  for (const [key, gen] of Object.entries(required)) {
    if (!merged[key]) {
      merged[key] = gen();
      generated.push(key);
    }
  }
  if (interactive) await promptOptional(merged);
  writeEnvAtomic(path, merged);
  ok(generated.length ? `.env generated new secrets: ${generated.join(", ")}` : ".env present (no regeneration needed)");
  return merged;
}

async function promptOptional(merged: Record<string, string>): Promise<void> {
  const prompts: [string, string][] = [
    ["ANTHROPIC_API_KEY", "Anthropic API key (Claude, for AI daily summaries)"],
    ["MEMENTO_AI_API_KEY", "Alt AI API key (OpenAI-compatible, e.g. Aliyun Dashscope)"],
  ];
  let anyAsked = false;
  for (const [key, label] of prompts) {
    if (merged[key] || !process.stdin.isTTY) continue;
    anyAsked = true;
    let val = "";
    try {
      val = (await ask(`  ${label} [skip]: `)).trim();
    } catch (e) {
      if (e instanceof Interrupted) throw e;
    }
    if (val) merged[key] = val;
  }
  if (!anyAsked) info("Skipping optional API key prompts (run again anytime to add them).");
}
